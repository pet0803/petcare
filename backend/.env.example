# ============================================
# PetCare AI 环境变量模板
# 使用方法：复制本文件为 .env，填入真实 API Key
#   PowerShell: Copy-Item .env.example .env
# ============================================

# ===== DeepSeek 大模型（问答生成）=====
# 获取地址：https://platform.deepseek.com （注册后创建 API Key）
DEEPSEEK_API_KEY=sk-请替换为你的DeepSeek密钥

# ===== SiliconFlow Embedding（文本向量化）=====
# 获取地址：https://siliconflow.cn （注册后有免费额度，BAAI/bge-m3 免费）
SILICONFLOW_API_KEY=sk-请替换为你的SiliconFlow密钥

# ===== 模型配置（默认即可，模型名迁移只需改这里）=====
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ===== RAG 参数 =====
TOP_K=4                       # 检索返回片段数
RETRIEVAL_THRESHOLD=0.45      # 相似度阈值（1-余弦距离），低于此值丢弃；bge-m3 无关文本基线约 0.3~0.45
CHUNK_SIZE=600                # 切片字符数
CHUNK_OVERLAP=120             # 相邻切片重叠字符数
MAX_UPLOAD_MB=20              # 上传文件大小上限（MB）
